(ns quarryops.physics-probe-test
  "The probe is the bot's only source of \"measured\"; these pin that it
  measures (every run numeric, count = expected), that the numbers come
  from the simulation (the derived boundary really straddles the
  tolerance flip), and that a changed solver would show."
  (:require [kotoba.test :refer [deftest is testing]]
            [quarryops.physics-probe :as probe]
            [quarryops.robotics :as robotics]))

(deftest probe-measures-every-run
  (let [p (probe/probe)]
    (is (= "itonami.physical-ai.probe.v1" (:physics-probe/schema p)))
    (is (pos? (:count p)))
    (is (= (:count p) (:expected p) (count (:runs p))))
    (testing "every run carries numeric energy, settling distance and tick count from the trajectory"
      (doseq [r (:runs p)]
        (is (number? (get-in r [:quantities :sim-impact-energy-j])))
        (is (number? (get-in r [:quantities :sim-settling-distance-m])))
        (is (pos? (get-in r [:quantities :ticks])))))))

(deftest impact-energy-and-velocity-rise-with-drop-height
  (let [qs (map :quantities (:runs (probe/probe)))]
    (is (apply < (map :sim-impact-energy-j qs)))
    (is (apply < (map :sim-impact-velocity-mps qs)))
    (is (apply < (map :sim-settling-distance-m qs)))))

(deftest impact-energy-stays-below-the-free-fall-identity
  (testing "no run gains energy: simulated KE at impact <= m g h (energy is not created by the solver)"
    (doseq [{:keys [input quantities]} (:runs (probe/probe))]
      (is (<= (:sim-impact-energy-j quantities)
              (* (:fragment-mass-kg input) robotics/g-mps2 (:bench-drop-height-m input)))))))

(deftest derived-boundary-straddles-the-tolerance-flip
  (let [h (probe/max-passing-drop-height-m)
        out? (fn [drop-m]
               (let [e {:fragment-mass-kg probe/fragment-mass-kg :bench-drop-height-m drop-m}]
                 (robotics/bench-face-settling-out-of-tolerance?
                  (merge e (robotics/bench-face-settling-telemetry-for e)))))]
    (is (number? h))
    (testing "at the boundary the fragment is contained; 1% higher it is not"
      (is (not (out? h)))
      (is (out? (* 1.01 h))))))

(deftest bracket-that-does-not-straddle-answers-nil
  (is (nil? (probe/max-passing-drop-height-m 0.5 5.0 10))))
